# Backend Core Secrets
DJANGO_SECRET_KEY=insecure-dev-secret-key-32-chars-minimum!!
DJANGO_ALLOWED_HOSTS=*
DATABASE_URL=sqlite:///db.sqlite3
IDENTIFIER_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
IDENTIFIER_HMAC_KEY_ID=v1
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
INTERNAL_SERVICE_TOKEN=dev-internal-service-token

# Configuration
MAX_INPUT_CHARS=5000
RETENTION_DAYS=30